+import numpy as np
+import torch
+from PIL import Image
+
+from ..utils.base_model import BaseModel
+
+# RoMa dense matcher (arXiv 2305.15404), pip `romatch` (MIT). Weights auto-download
+# via torch.hub on first use (roma_outdoor: DINOv2 ViT-L/14 + Parskatt release).
+#
+# Integration with hloc's match_dense: match_dense hands us a preprocessed RGB
+# image pair as tensors (1,3,H,W in [0,1]); we return warp-sampled keypoint pairs
+# + per-match certainties. RoMa resizes internally to its coarse resolution
+# (560x560 for outdoor) so we pass the received-tensor sizes to
+# to_pixel_coordinates -> keypoints land in the frame match_dense expects, and its
+# scale_keypoints() rescales them back to the original image. This mirrors the
+# EDGS corr_init sampling (upsample_preds=False, sample threshold 0.05,
+# sample(num=10k-20k)); reference: tools/reference_sources/edgs/source_corr_init.py.
+
+
+class Roma(BaseModel):
+    default_conf = {
+        "weights": "outdoor",       # "outdoor" | "indoor"
+        "model_name": "roma",       # kept for provenance
+        "max_num_matches": 15000,   # sampled correspondences per pair (EDGS: 10k-20k)
+        "min_certainty": 0.05,      # drop matches below this certainty (EDGS sample_thresh)
+        "upsample_preds": False,    # EDGS-informed: match at coarse 560x560 (fp16, fast)
+        "coarse_resolution": None,  # optional (h, w) override of the coarse match res
+    }
+    required_inputs = ["image0", "image1"]
+
+    def _init(self, conf):
+        from romatch import roma_indoor, roma_outdoor
+
+        device = "cuda" if torch.cuda.is_available() else "cpu"
+        if conf["weights"] == "indoor":
+            self.net = roma_indoor(device=device)
+        else:
+            self.net = roma_outdoor(device=device)
+        # EDGS-informed inference settings: coarse-resolution match, no upsample,
+        # non-symmetric (one forward pass, keypoints refined in image0).
+        self.net.upsample_preds = conf["upsample_preds"]
+        self.net.symmetric = False
+        if conf.get("coarse_resolution") is not None:
+            h, w = conf["coarse_resolution"]
+            self.net.h_resized, self.net.w_resized = int(h), int(w)
+
+    @staticmethod
+    def _to_pil(image: torch.Tensor) -> Image.Image:
+        # image: (1,3,H,W) or (3,H,W) float in [0,1] -> RGB PIL uint8
+        if image.dim() == 4:
+            image = image[0]
+        arr = (image.clamp(0, 1) * 255.0).round().byte()
+        arr = arr.permute(1, 2, 0).cpu().numpy()
+        if arr.shape[2] == 1:
+            arr = np.repeat(arr, 3, axis=2)
+        return Image.fromarray(arr)
+
+    @torch.no_grad()
+    def _forward(self, data):
+        image0, image1 = data["image0"], data["image1"]
+        device = image0.device
+        H0, W0 = image0.shape[-2:]
+        H1, W1 = image1.shape[-2:]
+
+        im_A = self._to_pil(image0)
+        im_B = self._to_pil(image1)
+
+        # Dense warp + per-pixel certainty (logits->sigmoid inside .match()).
+        warp, certainty = self.net.match(im_A, im_B, device=device)
+
+        # Certainty-weighted sampling of correspondences (normalized coords).
+        matches, certs = self.net.sample(
+            warp, certainty, num=self.conf["max_num_matches"]
+        )
+
+        # Map normalized [-1,1] coords -> pixels in the RECEIVED (preprocessed)
+        # frame; match_dense.scale_keypoints then rescales to original resolution.
+        kpts0, kpts1 = self.net.to_pixel_coordinates(matches, H0, W0, H1, W1)
+
+        # Drop low-certainty tail (EDGS keeps cert>sample_thresh; geometric
+        # verification downstream removes any remaining outliers). Applied
+        # UNCONDITIONALLY: if no match clears the floor, an EMPTY result is the
+        # correct output (returning the whole low-certainty tail would be worse).
+        # NOTE on the 0.05 default: romatch's sample() internally remaps
+        # certainty > its own sample_thresh (0.05) to 1.0 BEFORE multinomial
+        # sampling, so min_certainty=0.05 removes exactly the sub-threshold tail
+        # that sampling let through; raising min_certainty tightens further. The
+        # two thresholds are deliberately equal, not coincidentally.
+        keep = certs >= float(self.conf["min_certainty"])
+        kpts0, kpts1, certs = kpts0[keep], kpts1[keep], certs[keep]
+
+        return {
+            "keypoints0": kpts0,
+            "keypoints1": kpts1,
+            "scores": certs,
+        }
